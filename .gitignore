# Only the approved top-level repository layout may be added.
# Keep these exceptions aligned with the root README and repository structure.
/*
!/.agents/
!/ASL-CallAPP/
!/ASL-GlossTranslator/
!/ASL-MobileAPP/
!/ASL-ModelServer/
!/ASL-Web/
!/infra/
!/.gitignore
!/.gitmodules
!/README.md
!/asl-system.code-workspace
!/docker-compose.gloss-int8.yml
!/docker-compose.gloss-production.yml
!/docker-compose.gloss.yml
!/docker-compose.nginx.yml
!/run.ps1
!/run.sh

# Dependencies and generated application output inside approved directories
node_modules/
.pnpm-store/
dist/
build/
*.tsbuildinfo
build-info.json
.expo/
.next/
.turbo/
.nuxt/
target/
.gradle/
.cxx/
*.apk
*.aab
*.ipa
*.dmg
*.msi

# Python environments and caches
__pycache__/
*.py[cod]
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Private environments and signing material; example configuration stays visible
.env
.env.*
!.env.example
!.env.sample
!.env.*.example
!.env.*.sample
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision

# Local tools, release worktrees, exports, and documentation scratch space
.codex/
.release-tools/
.release-worktrees/
.sisyphus/
.dev-logs/
.docx-work/
.doc-qa/
outputs/
revision_documento/
instaladores/
model_onnx/
