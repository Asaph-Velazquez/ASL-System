# Copiar a infra/ec2/.env. Usar valores aleatorios diferentes, sin espacios.
# MONGO_PASSWORD: hexadecimal para evitar caracteres reservados en MongoDB URI.
MONGO_PASSWORD=
JWT_SECRET=
CALL_JWT_SECRET=
INTERPRETER_JWT_SECRET=
CALL_INTERNAL_TOKEN=

GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=80
ALLOWED_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost

# Solo para docker-compose.https.yml: DNS publico apuntando a EC2.
PUBLIC_HOST=api.example.com
ACME_EMAIL=you@example.com
